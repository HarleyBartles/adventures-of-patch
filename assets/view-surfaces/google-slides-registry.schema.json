{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adventures of Patch Google Slides view-surface registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_purpose",
    "canonicality_note",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "registry_purpose": {
      "type": "string",
      "const": "durable_gpt_view_surfaces_for_repo_canonical_assets"
    },
    "canonicality_note": {
      "type": "string"
    },
    "entries": {
      "type": "object",
      "description": "Keys are repo-relative image paths, for example assets/canon/patch/example.png.",
      "additionalProperties": {
        "$ref": "#/$defs/view_surface_entry"
      }
    }
  },
  "$defs": {
    "view_surface_entry": {
      "type": "object",
      "required": [
        "provider",
        "status",
        "source_repo_path",
        "source_commit_sha",
        "source_blob_sha",
        "presentation_id",
        "presentation_url",
        "slide_object_id",
        "created_by",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "const": "google-slides"
        },
        "status": {
          "type": "string",
          "enum": ["canonical", "stale", "blocked", "retired"]
        },
        "source_repo_path": {
          "type": "string",
          "pattern": "^assets/.+\\.(png|jpg|jpeg|webp)$"
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "asset_family_root": {
          "type": "string",
          "pattern": "^assets/.+/$"
        },
        "deck_group": {
          "type": "string"
        },
        "deck_index": {
          "type": "integer",
          "minimum": 1
        },
        "deck_slide_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "slide_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "view_mode": {
          "type": "string",
          "enum": ["single_image_slide"]
        },
        "presentation_id": {
          "type": "string",
          "minLength": 1
        },
        "presentation_url": {
          "type": "string",
          "format": "uri"
        },
        "slide_object_id": {
          "type": "string",
          "minLength": 1
        },
        "image_object_id": {
          "type": "string"
        },
        "view_presentation_title": {
          "type": "string"
        },
        "created_by": {
          "type": "string",
          "enum": ["gpt", "patch", "harley", "unknown"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
