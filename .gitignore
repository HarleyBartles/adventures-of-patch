.DS_Store
Thumbs.db

# local/editor state
.vscode/
.idea/

# temporary working files
tmp/
temp/
*.log

# generated caches
__pycache__/
.pytest_cache/

# contact-sheet emitted outputs are disposable local artifacts
output-zips/

# keep scratch local unless explicitly promoted
scratch/*
!scratch/.gitkeep

# Patch ingress lane: track the folder docs, not incoming zip payloads or scratch extractions
Patch/INGRESS/asset-zips/*.zip
Patch/INGRESS/asset-zips/**/*.zip
Patch/INGRESS/asset-zips/_work/
Patch/INGRESS/asset-zips/_extracted/
